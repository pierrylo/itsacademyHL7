var patientDepartment = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.1&apos;].toString() || &apos;NA&apos;;
var diagnosis = msg[&apos;OBX&apos;][&apos;OBX.5&apos;][&apos;OBX.5.1&apos;].toString() || &apos;N/A&apos;;

// Creating HTML content for the PDF
var htmlContent = &quot;&lt;html&gt;&lt;head&gt;&lt;title&gt;HL7 RAPPORTO INGRESSO PAZIENTE&lt;/title&gt;&lt;style&gt;body{font-family: Arial, sans-serif; margin: 40px; padding: 20px; background-color: #F8F8F8;} h1{color: #007BFF; font-size: 28px; margin-bottom: 20px; border-bottom: 2px solid #007BFF;} h2{color: #17A2B8; font-size: 24px; margin-top: 30px;} p{color: #6C757D; font-size: 16px; margin-top: 5px; margin-bottom: 5px;} strong{color: #DC3545;} .section{margin-top: 20px; border-bottom: 1px solid #DCDCDC; padding-bottom: 10px;}&lt;/style&gt;&lt;/head&gt;&quot;
