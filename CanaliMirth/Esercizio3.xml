			+&quot;&lt;div class=&apos;section&apos;&gt;&lt;h2&gt;Informazioni paziente&lt;/h2&gt;&quot; 
			+&quot;&lt;p&gt;&lt;strong&gt;Nome:&lt;/strong&gt;&quot; + patientName + &quot;&lt;/p&gt;&quot;
			+&quot;&lt;p&gt;&lt;strong&gt;Sesso:&lt;/strong&gt;&quot; + patientSex + &quot;&lt;/p&gt;&quot; 
			+ &quot;&lt;/div&gt;&lt;div class=&apos;section&apos;&gt;&lt;h2&gt;Diagnosi&lt;/h2&gt;&lt;p&gt;&quot; + diagnosis + &quot;&lt;/p&gt;&quot;
			+ &quot;&lt;/div&gt;&lt;h2&gt;Ulteriori dati&lt;/h2&gt;&lt;p&gt;dettagli ulteriori di diagnosi...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;&quot;;

// Set the HTML content to the &apos;pdfContent&apos; channel map variable
channelMap.put(&apos;pdfContent&apos;, htmlContent);</script>
